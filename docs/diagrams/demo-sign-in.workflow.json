{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "First-visit demo sign-in",
    "locale": "en",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "guest", "label": "Guest" },
    { "id": "spa", "label": "SPA" },
    { "id": "worker", "label": "Worker" }
  ],
  "phases": [
    { "id": "arrive", "label": "Arrive", "fromCol": 0, "toCol": 1 },
    { "id": "credentials", "label": "Issue credentials", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "enter", "label": "Create and enter", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": [
    "openApp",
    "sessionCheck",
    "signInPage",
    "loadCredentials",
    "prefillForm",
    "clickSignIn",
    "createDemoUser",
    "questions"
  ],
  "nodes": [
    {
      "id": "openApp",
      "lane": "guest",
      "col": 0,
      "type": "external",
      "label": "Open app",
      "sublabel": "first visit"
    },
    {
      "id": "emptySignUp",
      "lane": "guest",
      "col": 1,
      "type": "frontend",
      "label": "/sign-up",
      "sublabel": "empty custom form"
    },
    {
      "id": "sessionCheck",
      "lane": "spa",
      "col": 1,
      "type": "frontend",
      "label": "Session",
      "sublabel": "protectedRoute"
    },
    {
      "id": "signInPage",
      "lane": "spa",
      "col": 2,
      "type": "frontend",
      "label": "/sign-in",
      "sublabel": "cookie consent"
    },
    {
      "id": "prefillForm",
      "lane": "spa",
      "col": 3,
      "type": "frontend",
      "label": "Prefill form",
      "sublabel": "createdDemoUser"
    },
    {
      "id": "questions",
      "lane": "spa",
      "col": 5,
      "type": "frontend",
      "label": "Questions",
      "sublabel": "session.retry"
    },
    {
      "id": "alreadySignedIn",
      "lane": "spa",
      "col": 0,
      "type": "frontend",
      "label": "Questions",
      "sublabel": "existing session"
    },
    {
      "id": "loadCredentials",
      "lane": "worker",
      "col": 2,
      "type": "backend",
      "label": "GET /api/demo-user",
      "sublabel": "cookie or generate",
      "tag": "no insert",
      "width": 148
    },
    {
      "id": "clickSignIn",
      "lane": "guest",
      "col": 4,
      "type": "external",
      "label": "Sign in",
      "sublabel": "submit"
    },
    {
      "id": "createDemoUser",
      "lane": "worker",
      "col": 4,
      "type": "backend",
      "label": "POST /api/demo-user",
      "sublabel": "create or sign in",
      "tag": "D1 user",
      "width": 148
    },
    {
      "id": "customEmail",
      "lane": "guest",
      "col": 5,
      "type": "security",
      "label": "Custom email",
      "sublabel": "Better Auth sign-in"
    }
  ],
  "edges": [
    { "id": "open-session", "from": "openApp", "to": "sessionCheck" },
    {
      "id": "open-signup",
      "from": "openApp",
      "to": "emptySignUp",
      "label": "direct URL",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "session-signin",
      "from": "sessionCheck",
      "to": "signInPage",
      "label": "logged out"
    },
    {
      "id": "session-questions",
      "from": "sessionCheck",
      "to": "alreadySignedIn",
      "label": "logged in",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "signin-get",
      "from": "signInPage",
      "to": "loadCredentials",
      "label": "GET"
    },
    { "id": "get-prefill", "from": "loadCredentials", "to": "prefillForm" },
    { "id": "prefill-click", "from": "prefillForm", "to": "clickSignIn" },
    {
      "id": "click-post",
      "from": "clickSignIn",
      "to": "createDemoUser",
      "label": "demo email",
      "variant": "emphasis"
    },
    { "id": "post-questions", "from": "createDemoUser", "to": "questions" },
    {
      "id": "click-custom",
      "from": "clickSignIn",
      "to": "customEmail",
      "label": "custom email",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Create on Sign in",
      "items": [
        "GET /api/demo-user reuses createdDemoUser or invents credentials and does not insert a D1 row",
        "POST /api/demo-user creates the demo user or signs in if that email exists"
      ]
    }
  ]
}
