    "@reatom/react": "^1001.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.52.0",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
